# Postgres. Everything works against a bundled container, Supabase, Neon or RDS.
DATABASE_URL=postgresql://postgres:pergola@localhost:5432/pergola

# Only needed when DATABASE_URL points at a transaction-mode pooler (Supabase :6543,
# pgBouncer). LISTEN/NOTIFY does not survive a pooler, so the realtime listener needs
# a direct connection. Leave unset when DATABASE_URL is already direct.
# DATABASE_DIRECT_URL=postgresql://...@db.xxx.supabase.co:5432/postgres

PORT=3000
NODE_ENV=development

# Signing key for session cookies. Generate one per instance:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me
# The URL people actually reach this instance on. Used for callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to sign in, comma separated. Needed when people reach the
# instance through a hostname that differs from BETTER_AUTH_URL.
# TRUSTED_ORIGINS=https://boards.example.com

# ---------------------------------------------------------------------------
# Where uploaded files live.
#
# "local" is a volume, and all a self-hosted instance needs. "supabase" puts
# them in a private Storage bucket instead, which is what a host with no disk
# (or more than one replica) needs. Bytes are served through /api/files/:id
# either way, so the bucket never has to be public.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local
# STORAGE_DIR=./data/uploads
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=attachments

# ---------------------------------------------------------------------------
# Runtime shape. Detected, and worth setting only on a host that is neither
# guessed correctly: "node" is one long-lived process with a port and a
# WebSocket, "serverless" is a function woken per request, where live updates
# are streamed over SSE instead. See README, "Vercel and Supabase".
# ---------------------------------------------------------------------------
# RUNTIME=node
# REALTIME_STREAM_SECONDS=50
# REALTIME_POLL_MS=2000

# Let webhooks reach private and loopback addresses. Development and tests only:
# leaving this on in production lets anyone who can add a webhook reach the
# server's own network.
# WEBHOOK_ALLOW_PRIVATE=false
